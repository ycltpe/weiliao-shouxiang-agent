# ========== LLM 凭据（OpenAI SDK 默认读取，非 WEILIAO_ 前缀） ==========
# OpenAI 兼容网关凭据（Story 7.1）：ChatOpenAI 惰性构造，SDK 默认读取本
# 环境变量；服务启动不校验凭据——/health 就绪不代表凭据可用，快速启动
# 须将本占位符替换为真实密钥
OPENAI_API_KEY=replace-with-your-openai-api-key

# 网关服务地址（OpenAI SDK 默认读取；缺省=官方 API）。G1-A 决策：注释
# 形态保留占位——配置不存在的地址会令 SDK 静默指向坏主机（熔断跳闸 +
# llm_breaker_alert 洪泛）；确认网关可用后再取消注释：
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# ========== 会话与缓存（Story 1.3 / 3.3） ==========
# 会话状态 Redis（Story 1.3，会话状态唯一写入者）
WEILIAO_REDIS_URL=redis://127.0.0.1:6379/0

# L1 进程内缓存 TTL 秒数（Story 3.3，AD-5 硬上限 30，传入 >30 启动
# fail-fast）：仅存会话热点快照，事实卡片严禁入 L1
WEILIAO_L1_TTL_SECONDS=30

# ========== 意图分类（Story 2.2） ==========
# 意图分类器实现（Story 2.2；默认 llm_zero_shot，none 保留占位行为；
# 非法值启动 fail-fast）
WEILIAO_INTENT_CLASSIFIER=llm_zero_shot

# 意图分类模型 alias（llm_zero_shot 缺省 gpt-4o-mini；构造参数 > 本变量
# > 模块缺省）
WEILIAO_INTENT_MODEL=gpt-4o-mini

# ========== 房源事件同步消费者（Story 3.2，可选启停） ==========
# Kafka broker 列表（Story 3.2/5.2 共用门控）：非空才启动 house.sync
# 消费者与转人工指令发送器；本地零 broker 零噪音——删除本行即不启动
# 消费者与发送器（服务仍就绪）
WEILIAO_KAFKA_BROKERS=localhost:9092

# 房源同步 topic（Story 3.2；默认 house.sync.trigger）
WEILIAO_KAFKA_TOPIC=house.sync.trigger

# 房源同步消费组（Story 3.2；默认 weiliao-house-sync）
WEILIAO_KAFKA_GROUP_ID=weiliao-house-sync

# ========== 缓存命中率指标（Story 3.4） ==========
# 命中率/审核/熔断器/路由结构化 stderr 日志的定时发射间隔秒数（Story 3.4，
# A 方案；默认 60，非正整数启动 fail-fast）
WEILIAO_METRICS_LOG_SECONDS=60

# ========== 风控中台审核（Story 4.4） ==========
# 风控中台审核 endpoint（Story 4.4，双审核第二道）。G1-A 决策：注释形态
# 保留占位——照抄 .env 后处于未配置态，运行期 fail-closed（任何 LLM 草稿
# 视为不通过、回模板兜底，绝不默认放行）；配置不存在的地址会令每次草稿
# 500ms 超时 + 样本 ≥20 后 risk_review_alert 常亮。确认中台可用后再取消注释：
# WEILIAO_RISK_REVIEW_ENDPOINT=https://risk-review.example.com/api/review

# 审核超时毫秒数（Story 4.4；默认 500，可调 300–800，越界启动 fail-fast）
WEILIAO_RISK_REVIEW_TIMEOUT_MS=500

# 审核通过率告警阈值（Story 4.4；默认 0.95，须 0–1，越界启动 fail-fast；
# 累计审核样本 ≥20 且跌破阈值时发射 ERROR 级 risk_review_alert 日志）
WEILIAO_RISK_REVIEW_PASS_RATE_THRESHOLD=0.95

# ========== LLM 生成与熔断器（Story 4.3 / 4.5） ==========
# 主模型 alias（Story 4.3；默认 gpt-4o，构造参数 > 本变量 > 模块缺省）：
# 名单外意图与 intent=None 走主模型
WEILIAO_LLM_MODEL=gpt-4o

# LLM 熔断器冷却期秒数（Story 4.5；默认 10，非正或非有限 nan/inf 启动
# fail-fast）：OpenAI 侧故障（429/5xx/超时/网络）跳闸后，冷却期内请求
# 不调子图、立即回模板兜底
WEILIAO_LLM_BREAKER_COOLDOWN_SECONDS=10

# LLM 熔断器恢复步进（Story 4.5；默认 0.1，须 0<x<=1，越界启动
# fail-fast）：冷却满后按该比例确定性放量试探，成功递增、达 100% 闭合。
# 量化口径：实际档位 N=round(1/step)，放行比例=k/N（0.1→10 档按 10%
# 步进；0.3→3 档按 33.3% 步进）
WEILIAO_LLM_BREAKER_RECOVERY_STEP=0.1

# ========== 模型路由与 token 预算护栏（Story 4.6） ==========
# 模型路由 mini 模型 alias（Story 4.6；默认 gpt-4o-mini，strip 后为空
# 启动 fail-fast）：名单内简单意图与预算收紧期走该模型生成，主模型 alias
# 仍经 WEILIAO_LLM_MODEL 配置
WEILIAO_LLM_MINI_MODEL=gpt-4o-mini

# 路由简单意图名单（Story 4.6；默认 GREETING,LOCATION，逗号分隔；
# 解析为空或含未知意图标签启动 fail-fast）：名单内意图走 mini 模型，名单外
# 与 intent=None（分类 fail-closed）一律走主模型
WEILIAO_LLM_ROUTING_SIMPLE_INTENTS=GREETING,LOCATION

# 路由滑窗 token 预算阈值（Story 4.6；默认 50000，非正整数启动
# fail-fast）：窗口内累计成功生成 total_tokens ≥ 该值即收紧、全部意图
# 强制 mini，回落到阈值以下自动恢复
WEILIAO_LLM_ROUTING_BUDGET_TOKENS=50000

# 路由滑窗时长秒数（Story 4.6；默认 60，非正或非有限 nan/inf 启动
# fail-fast）：预算累计的滑动窗口长度
WEILIAO_LLM_ROUTING_WINDOW_SECONDS=60

# ========== 转人工（Story 5.1 / 5.2） ==========
# 硬触发追问阈值（Story 5.1；默认 3，非正整数启动 fail-fast）：同一
# 意图追问序号（record_followup Redis 权威值）≥ 该值即触发转人工
WEILIAO_HANDOFF_FOLLOWUP_THRESHOLD=3

# 硬触发红线意图集合（Story 5.1；默认 NEGOTIATION,LOAN_POLICY,COMPLAINT，
# 逗号分隔，解析为空或含未知意图标签启动 fail-fast）：命中任一即触发
# 转人工，下游 cache/llm/risk/assembler 零执行
WEILIAO_HANDOFF_REDLINE_INTENTS=NEGOTIATION,LOAN_POLICY,COMPLAINT

# 内置负面词表文件路径（Story 5.1；默认仓库内置 handoff/negative_words.txt
# 绝对路径，风控中台产出发布进仓库）：文件不可读或无词条启动 fail-fast
# （不静默放行）。G1-A 决策：注释形态保留占位——样例为相对路径，以启动
# cwd 解析，异 cwd 启动会 fail-fast 且报错误导；确认须自定义词表且从仓库
# 根目录启动时再取消注释：
# WEILIAO_HANDOFF_NEGATIVE_WORDS_PATH=src/weiliao_agent/handoff/negative_words.txt

# 转人工指令 Kafka topic（Story 5.2；默认 handoff.commands，strip 后为空
# 启动 fail-fast）：硬触发命中后经纪人工作台消费该 topic 接收转交指令
# （单向，只出不进，本服务不新增消费者）；复用 WEILIAO_KAFKA_BROKERS
# 门控——broker 未配置则不装配发送器，出口文案语义不变
WEILIAO_HANDOFF_KAFKA_TOPIC=handoff.commands

# 转人工指令死信队列 topic（Story 5.2；默认 handoff.commands.dlq，strip
# 后为空或与指令 topic 相同启动 fail-fast）：指令发送重试 3 次仍失败写入
# 该 topic + ERROR 级 handoff_command_alert 告警日志；DLQ 写失败仅告警
# 日志，买家应答不变
WEILIAO_HANDOFF_KAFKA_DLQ_TOPIC=handoff.commands.dlq
