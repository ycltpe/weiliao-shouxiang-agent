# 模型名称
LLM_MODEL_ID=

# API密钥
LLM_API_KEY=

# 服务地址
LLM_BASE_URL=

# 会话状态 Redis（Story 1.3，会话状态唯一写入者；默认 redis://127.0.0.1:6379/0）
WEILIAO_REDIS_URL=

# 风控中台审核 endpoint（Story 4.4，双审核第二道；未配置=运行期 fail-closed，
# 任何 LLM 草稿视为不通过、回模板兜底，绝不默认放行）
WEILIAO_RISK_REVIEW_ENDPOINT=

# 审核超时毫秒数（Story 4.4；默认 500，可调 300–800，越界启动 fail-fast）
WEILIAO_RISK_REVIEW_TIMEOUT_MS=

# 审核通过率告警阈值（Story 4.4；默认 0.95，须 0–1，越界启动 fail-fast；
# 累计审核样本 ≥20 且跌破阈值时发射 ERROR 级 risk_review_alert 日志）
WEILIAO_RISK_REVIEW_PASS_RATE_THRESHOLD=

# LLM 熔断器冷却期秒数（Story 4.5；默认 10，非正启动 fail-fast）：
# OpenAI 侧故障（429/5xx/超时/网络）跳闸后，冷却期内请求不调子图、
# 立即回模板兜底
WEILIAO_LLM_BREAKER_COOLDOWN_SECONDS=

# LLM 熔断器恢复步进（Story 4.5；默认 0.1，须 0<x<=1，越界启动
# fail-fast）：冷却满后按该比例确定性放量试探，成功递增、达 100% 闭合。
# 量化口径：实际档位 N=round(1/step)，放行比例=k/N（0.1→10 档按 10%
# 步进；0.3→3 档按 33.3% 步进）
WEILIAO_LLM_BREAKER_RECOVERY_STEP=
