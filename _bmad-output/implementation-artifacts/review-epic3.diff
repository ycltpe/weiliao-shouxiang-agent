+
+def record_cache_event(
+    trace_id: str | None,
+    *,
+    operation: str,
+    stage: str,
+    metadata: Mapping[str, Any] | None = None,
+) -> None:
+    """缓存事件写入消息 trace（Story 3.1，L0 客户端复用）。
+
+    事件 taxonomy（operation）：``hit``（读命中）/ ``miss``（L0 未命中，
