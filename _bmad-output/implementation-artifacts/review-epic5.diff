+def test_negative_words_normalized_in_constructor() -> None:
+    # 空/纯空白词条构造侧归一：'' 是任意消息的子串，脏词条会令负面
+    # 条件命中一切消息（全部误转人工）；strip 后丢弃，语义不变。
+    assessor = HardTriggerAssessor(negative_words=["  骗子 ", "", "   "])
