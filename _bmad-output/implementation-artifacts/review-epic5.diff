+def _payload(timestamp: datetime = TS_1, trace_id: str | None = None) -> dict[str, Any]:
+    payload: dict[str, Any] = {
+        "session_id": SESSION_ID,
+        "house_id": "house-001",
+        "timestamp": timestamp.isoformat(),
+        "message": "房子还有吗",
+    }
+    if trace_id is not None:
+        payload["trace_id"] = trace_id
+    return payload
