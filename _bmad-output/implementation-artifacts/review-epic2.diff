+        text = message.lower()
+        for tag, keywords in self._KEYWORDS.items():
+            if any(keyword in text for keyword in keywords):
+                return IntentClassification(tag=tag, confidence=0.8)
+        return IntentClassification(tag="UNKNOWN", confidence=0.6)
