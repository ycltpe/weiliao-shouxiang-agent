+        "timestamp": "2026-11-06T10:00:00+08:00",
+        "trace_id": "trace-001",
+        "intent": intent,
+    }
+
+
+class _RaisingFilter(Filter):
+    name = "risk_review"
+
+    def process(self, envelope: Envelope) -> Envelope:
+        msg = "review failed"
+        raise RuntimeError(msg)
+
+
+class _FailingSessionManager:
