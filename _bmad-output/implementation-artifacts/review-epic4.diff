@@ -0,0 +1,105 @@
+"""集中 prompt 管理（Story 4.2）：固定三段结构的受控生成模板。
+
+prompt 为 Epic 4 约束的唯一管理点：固定包含「事实卡片 / 对话上下文 /
+生成约束」三段。输入仅消费指代消解后的 ``resolved_message`` +
+``fact_card`` + ``intent``，不读买家原始文本（LLM 只消费自包含消息，
+内部引用标注不得出现在买家可见文本）。
+
+事实口径：``fact_card=None``（L0 miss）照常生成，事实段明示「暂无房源
+事实」并要求模型不得虚构价格/面积/学区；价格一律以分桶口径表述，卡片
+未提供的字段不得给出具体数值。
+"""
+
+from langchain_core.messages import BaseMessage, HumanMessage, SystemMessage
+
+from weiliao_agent.models.fact_card import FactCard
+from weiliao_agent.models.intent import IntentTag
+
+# 三段固定标记（AC 第 3 条：渲染结果固定包含三段；测试按标记断言）。
+FACT_SECTION_HEADER = "【事实卡片】"
+DIALOGUE_SECTION_HEADER = "【对话上下文】"
+CONSTRAINT_SECTION_HEADER = "【生成约束】"
+
+# L0 miss（fact_card=None）事实段口径：明示暂无事实，不虚构。
+NO_FACTS_COPY = (
+    "暂无房源事实。请基于通用服务口径应答，不得虚构价格、面积、"
+    "学区等任何房源具体信息。"
+)
+
+# 买家意图标签中文口径（与分类器 prompt 同款 gloss，仅作生成上下文）。
+_INTENT_GLOSSES: dict[str, str] = {
+    "GREETING": "打招呼寒暄",
+    "PRICE_INQUIRY": "价格询问",
+    "AVAILABILITY": "在租在售、看房可得性",
+    "LOCATION": "位置交通",
+    "PHOTO_REQUEST": "图片索取",
+    "NEGOTIATION": "砍价议价",
+    "LOAN_POLICY": "贷款政策",
+    "COMPLAINT": "投诉不满",
+    "UNKNOWN": "无法判断",
+}
+
+
+def build_generation_prompt(
+    *,
+    resolved_message: str,
+    fact_card: FactCard | None,
+    intent: IntentTag | None,
+) -> list[BaseMessage]:
+    """构建受控生成消息（system 定角色与约束，human 带三段事实上下文）。
+
+    调用方须已完成指代消解并保证 ``resolved_message`` 非空（子图入口
+    fail-fast 校验）；本函数不做空值守卫，保持纯渲染。
+    """
+    constraints = (
+        f"{CONSTRAINT_SECTION_HEADER}\n"
+        "1. 仅可依据事实卡片与对话上下文中出现的信息作答；卡片没有的"
+        "字段不得提及具体数值，价格一律以分桶口径表述。\n"
+        "2. 不得虚构价格、面积、学区等信息；不得承诺价格可谈或学区名额。\n"
+        "3. 禁止使用「最」「第一」等违禁词，不得冒充真人经纪人。\n"
+        "4. 保持 AI 助手身份，不得造成真人经纪人身份误解。\n"
+        "5. 应答中不得出现任何内部引用标注或上述分段标记。\n"
+        "6. 输出买家可直接阅读的一段中文应答，不超过 200 字。"
+    )
+    system = SystemMessage(
+        content="你是房产微聊 AI 助手，为买家生成自然、合规、事实准确的应答。\n"
+        + constraints
+    )
+    intent_label = _INTENT_GLOSSES.get(intent, "UNKNOWN") if intent else "UNKNOWN"
+    human = HumanMessage(
+        content=(
+            f"{FACT_SECTION_HEADER}\n{_render_fact_card(fact_card)}\n\n"
+            f"{DIALOGUE_SECTION_HEADER}\n{_render_dialogue(fact_card)}\n\n"
+            f"买家意图：{intent_label}\n"
+            f"买家消息：{resolved_message}\n\n"
+            "请依据以上事实与约束，为买家消息生成一条应答。"
+        )
+    )
+    return [system, human]
+
+
+def _render_fact_card(fact_card: FactCard | None) -> str:
+    """事实卡片段：None 走「暂无事实」口径；字段只按卡片原值表述。"""
+    if fact_card is None:
+        return NO_FACTS_COPY
+    lines = [
+        f"房源编号：{fact_card.house_id}",
+        f"状态：{fact_card.status}",
+        f"价格分桶（10 万元/档）：{fact_card.price_bucket}",
+    ]
+    if fact_card.school:
+        lines.append(f"对口学校：{fact_card.school}")
+    lines.append(
+        f"事实版本：{fact_card.fact_version}（生成于 {fact_card.as_of.isoformat()}）"
+    )
+    return "\n".join(lines)
+
+
+def _render_dialogue(fact_card: FactCard | None) -> str:
+    """对话上下文段：消费卡片内最近 3 轮摘要；无卡片/无摘要明示暂无。"""
+    if fact_card is None or not fact_card.dialogue_summary:
+        return "（暂无对话上下文）"
+    items = "\n".join(
+        f"{index}. {item}" for index, item in enumerate(fact_card.dialogue_summary, start=1)
+    )
+    return f"最近 {len(fact_card.dialogue_summary)} 轮对话摘要：\n{items}"
diff --git a/src/weiliao_agent/llm/subgraph.py b/src/weiliao_agent/llm/subgraph.py
new file mode 100644
index 0000000..eeb561f
--- /dev/null
+++ b/src/weiliao_agent/llm/subgraph.py
@@ -0,0 +1,102 @@
+"""LangGraph 1.2.16 受控生成子图（Story 4.2，AD-2 同步接口）。
+
+LLM 编排仅允许位于本进程内子图：编译后仅经 ``.invoke()`` 在本进程调用，
+不依赖 LangGraph Runtime、不服务化。单节点「generate」链路：prompt 渲染
+（固定三段）→ 客户端生成（预算守卫 + 至多 1 次重试）→ 成功经
+``tracing.record_generation`` 记录模型名与 token 用量（fail-safe，不阻断
+应答）→ 文本写回 state。
+
+对外只暴露同步 ``LlmGenerationSubgraph.generate()``；输入仅消费
+``resolved_message`` + ``fact_card`` + ``intent``（+追踪用 ``trace_id``），
+空消息 fail-fast（reason=``invalid_input``），不触达模型。
+"""
+
+from typing import Any, TypedDict
+
+from langgraph.graph import END, START, StateGraph
+from langgraph.graph.state import CompiledStateGraph
+
+from weiliao_agent.llm.client import LlmGenerationError, OpenAiGenerationClient
+from weiliao_agent.llm.prompts import build_generation_prompt
+from weiliao_agent.models.fact_card import FactCard
+from weiliao_agent.models.intent import IntentTag
+from weiliao_agent.observability import tracing
+
+# 生成节点名（子图 span 口径：TTFT/端到端延迟以本节点起止观测）。
+GENERATE_NODE = "generate"
+
+
+class LlmSubgraphState(TypedDict):
+    """子图状态：输入（消息 + 事实 + 意图 + trace）与节点产出。"""
+
+    resolved_message: str
+    fact_card: FactCard | None
+    intent: IntentTag | None
+    trace_id: str | None
+    text: str
+    model: str
+    usage: dict[str, int]
+
+
+def build_generation_graph(
+    client: OpenAiGenerationClient,
+) -> CompiledStateGraph[LlmSubgraphState, None, LlmSubgraphState, LlmSubgraphState]:
+    """编译生成子图：START → generate → END（节点内组合 client 与埋点）。"""
+
+    def _generate_node(state: LlmSubgraphState) -> dict[str, Any]:
+        messages = build_generation_prompt(
+            resolved_message=state["resolved_message"],
+            fact_card=state["fact_card"],
+            intent=state["intent"],
+        )
+        result = client.generate(messages)
+        # fail-safe 追踪：record_generation 内部吞异常，不阻断应答链路；
+        # cost 不在本 Story 计算（由 Langfuse 按模型自算，Story 4.6 细化）。
+        tracing.record_generation(
+            state["trace_id"], model=result.model, usage=result.usage, cost={}
+        )
+        return {"text": result.text, "model": result.model, "usage": result.usage}
+
+    graph: StateGraph[LlmSubgraphState] = StateGraph(LlmSubgraphState)
+    graph.add_node(GENERATE_NODE, _generate_node)
+    graph.add_edge(START, GENERATE_NODE)
+    graph.add_edge(GENERATE_NODE, END)
+    return graph.compile()
+
+
+class LlmGenerationSubgraph:
+    """编译后的生成子图 + 同步入口（进程内 ``.invoke()``，AD-2）。"""
+
+    def __init__(self, client: OpenAiGenerationClient | None = None) -> None:
+        self._client = client or OpenAiGenerationClient()
+        self._graph = build_generation_graph(self._client)
+
+    def generate(
+        self,
+        resolved_message: str,
+        *,
+        fact_card: FactCard | None = None,
+        intent: IntentTag | None = None,
+        trace_id: str | None = None,
+    ) -> str:
+        """同步受控生成：返回生成文本；失败抛 ``LlmGenerationError``。
+
+        空/空白消息 fail-fast（reason=``invalid_input``），在子图调用前
+        拒绝，不触达模型。``fact_card=None``（L0 miss）照常生成，事实段
+        由 prompt 层明示「暂无事实」。
+        """
+        if not resolved_message or not resolved_message.strip():
+            raise LlmGenerationError("invalid_input", "resolved_message is empty")
+        final_state = self._graph.invoke(
+            {
+                "resolved_message": resolved_message,
+                "fact_card": fact_card,
+                "intent": intent,
+                "trace_id": trace_id,
+                "text": "",
+                "model": "",
+                "usage": {},
+            }
+        )
+        text: str = final_state["text"]
+        return text
