+        if not 0.0 <= value <= 1.0:
+            msg = f"pass_rate_threshold must be within 0-1, got {value!r}"
+            raise ValueError(msg)
+        with self._lock:
+            self._pass_rate_threshold = value
+
+
+# 模块级单例：risk_review 热路径与组合根（/health 响应、定时日志）共用。
