+class RiskReviewMetricsSnapshot(TypedDict):
+    """``snapshot()`` 返回结构（/health 响应与定时日志共用）。"""
+
+    total: int  # 分母：实际审核调用数（含超时/错误）
+    passed: int  # 分子：passed
